# ============================================================
# AIVA CRM
# Local development configuration
# ============================================================

ENVIRONMENT=development


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=aiva_crm
POSTGRES_USER=aiva
POSTGRES_PASSWORD=aiva_local_dev

DATABASE_URL=postgresql+asyncpg://aiva:aiva_local_dev@postgres:5432/aiva_crm


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_URL=redis://redis:6379/0


# ------------------------------------------------------------
# API security
# ------------------------------------------------------------

# Required. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Where links in invitation and password-reset emails point.
APP_BASE_URL=http://localhost:3000
